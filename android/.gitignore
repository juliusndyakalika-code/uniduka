# Build outputs. Regenerated by ./release.sh; the AAB is uploaded to Play and
# should never be tracked, or every build churns a ~1MB binary in git history.
app-release-bundle.aab
app-release-signed.apk
app-release-unsigned-aligned.apk
*.idsig
build/
app/build/
.gradle/
local.properties

# Signing material must never be in the repo. The keystore lives in
# ~/.mauzohalisi-signing/. These patterns exist so an accidental copy into the
# project cannot be committed.
*.keystore
*.jks
keystore-password.txt
