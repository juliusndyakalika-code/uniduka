// ─── CONSIGNMENT ─────────────────────────────────────────────────────────────

model ConsignmentPartner {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  sales ConsignmentSale[]

  @@map("consignment_partners")
}

model ConsignmentSale {
  id        String             @id @default(cuid())
  shopId    String
  shop      Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  partnerId String
  partner   ConsignmentPartner @relation(fields: [partnerId], references: [id])

  productName  String
  costPrice    Float // owed to partner per unit
  sellingPrice Float // sold to customer for
  qty          Float
  profit       Float // (sellingPrice - costPrice) * qty
  notes        String?

  paymentMethod PaymentMethod @default(CASH)
  amountPaid    Float         @default(0) // collected from customer; < sellingPrice*qty means outstanding (credit)

  // Debtor — captured only for credit (DEBIT) sales so the balance is collectable
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  soldById String
  soldBy   User   @relation(fields: [soldById], references: [id])

  soldAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@map("consignment_sales")
}

// ─── INVOICING ───────────────────────────────────────────────────────────────

// Per-shop document numbering. Tax authorities expect invoice numbers to be
// sequential with no gaps, so they cannot be derived from a row count (which
// races) or from a timestamp. The counter is bumped with an atomic increment.
model DocumentSequence {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind   String // "INVOICE" | "TAX_INVOICE"
  prefix String @default("INV")
  next   Int    @default(1)

  @@unique([shopId, kind])
  @@map("document_sequences")
}

// A bill issued to a customer, typically before payment. Independent of
// Transaction until fulfilment: issuing an invoice moves no stock and books no
// revenue, so an unpaid or cancelled invoice can never distort inventory or
// reporting. On fulfilment it deducts stock and creates the Transaction, the
// same rule storefront orders follow.
model Invoice {
  id        String        @id @default(cuid())
  shopId    String
  shop      Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Unique per shop, not globally: numbering restarts at 1 for every shop, so
  // two shops legitimately both hold an INV-000001.
  invoiceNo String
  status    InvoiceStatus @default(DRAFT)

  // Bill-to. customerId links a CRM record when there is one; the snapshot
  // fields are always written so the document stays accurate if the customer
  // record is later edited or removed.
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  billToName    String
  billToTin     String?
  billToPhone   String?
  billToEmail   String?
  billToAddress String?

  // Money, snapshotted at issue time
  subtotal       Float
  discountAmount Float @default(0)
  taxAmount      Float @default(0)
  total          Float

  notes String?
  terms String?

  issuedAt     DateTime?
  dueAt        DateTime?
  paidAt       DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // Goods handover — orthogonal to payment status
  fulfilledAt   DateTime?
  transactionId String?   @unique

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments InvoicePayment[]

  @@unique([shopId, invoiceNo])
  @@index([shopId, status])
  @@index([shopId, dueAt])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Nullable: an invoice may carry lines that are not catalogue products,
  // such as delivery, labour or a one-off charge.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  name        String
  description String?
  quantity    Float
  unitLabel   String  @default("ea")
  unitPrice   Float
  discountPct Float   @default(0)
  taxRate     Float   @default(0)
  taxAmount   Float   @default(0)
  lineTotal   Float

  @@map("invoice_items")
}

model InvoicePayment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  method    PaymentMethod
  amount    Float
  reference String?
  note      String?
  paidAt    DateTime      @default(now())

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@map("invoice_payments")
}

// ─── STOREFRONT ORDERS ───────────────────────────────────────────────────────

// An online order placed from a shop's public storefront by someone with no
// account. It is a *request* until the shop accepts it, and it never touches
// inventory until FULFILLED — otherwise fake orders could zero out real POS
// stock. On fulfilment it converts into a Transaction so it flows through all
// existing reporting.
model Order {
  id      String @id @default(cuid())
  shopId  String
  shop    Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderNo String @unique

  status     OrderStatus    @default(PENDING_VERIFICATION)
  fulfilment FulfilmentType @default(DELIVERY)

  // Buyer — free-text, no platform account. customerId is linked opportunistically
  // when the phone matches an existing CRM record for this shop.
  buyerName  String
  buyerPhone String
  buyerEmail String?
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Delivery
  deliveryAddress String?
  deliveryNote    String?

  // Phone verification. Fields exist so the OTP flow can be switched on as soon
  // as an SMS provider is configured; until then orders start at PENDING and
  // abuse is held back by rate limiting plus mandatory shop approval.
  phoneVerified Boolean   @default(false)
  otpHash       String?
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)

  // Amounts, snapshotted at order time so later price edits don't rewrite history
  subtotal    Float
  deliveryFee Float @default(0)
  total       Float

  // Set once fulfilled, linking the order to the sale it became
  transactionId String? @unique

  note         String?
  cancelReason String?

  // Unanswered orders expire so they don't sit in the inbox forever
  expiresAt   DateTime
  confirmedAt DateTime? // buyer verified their phone
  acceptedAt  DateTime?
  fulfilledAt DateTime?
  closedAt    DateTime? // rejected / cancelled / expired

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([shopId, status])
  @@index([buyerPhone])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  name      String // snapshot — the listing as the buyer saw it
  quantity  Float
  unitLabel String
  unitPrice Float
  lineTotal Float

  @@map("order_items")
}

